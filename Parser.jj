options {
    STATIC = false;
    IGNORE_CASE = true; //Para que no distinga mayusculas y minusculas
}
/*
 * Parser
 */
PARSER_BEGIN(MiniREXX)
public class MiniREXX {
    public static void main (String[] args) throws ParseException {
        //codigo principal
        try {
            MiniREXX parser = new MiniREXX(System.in);
            parser.programa();
            System.out.println("\n--- ¡Compilación y generación de código finalizadas con éxito! ---");
        } catch (TokenMgrError e) {
            System.err.println("Error léxico: " + e.getMessage());
        } catch (ParseException e) {
            System.err.println("Error sintáctico: " + e.getMessage());
        }
    }
}
PARSER_END(MiniREXX)

/*
 * The terminals
 */

SKIP : /* Espacios en blanco y separadores simples */
{
    " "
|   "\t"
|   "\n"
|   "\r"
|   ";"
|   < "/*" (~["*"])* "*/" >
}

TOKEN : /* Palabras reservadas */
{
  < PULL: "pull" >
| < SAY: "say" >
| < IF: "if" >
| < THEN: "then" >
| < ELSE: "else" >
| < DO: "do" >
| < END: "end" >
| < WHILE: "while" >
| < UNTIL: "until" >
| < TO: "to" >
| < BY: "by" >
| < SELECT: "select" >
| < WHEN: "when" >
| < OTHERWISE: "otherwise" >
| < CHOOSE: "choose" >
| < ADDING: "adding" >
| < SUBTRACTING: "subtracting" >
}

TOKEN :
{
    < ID: (["a"-"z","A"-"Z","_"]) (["a"-"z","A"-"Z","0"-"9","_"])* >
|   < NUM: (["0"-"9"])+ >
|   < CAD: "\"" (~["\n","\""])* "\"" | "'" (~["\n","'"])* "'" > /* Cadenas entre comillas dobles o simples */
}
TOKEN :
{
    < ASIG: "=" >
|   < PLUS: "+" >
|   < MINUS: "-" >
|   <MULTIPLY: "*" >
|   <DIVIDE: "/" >
|   <DIFF: "<>" >
|   <LESS_THAN: "<" >
|   <GREAT_THAN: ">" >
|   <LESS_EQ: "<=" >
|   <GREAT_EQ: ">=" >
|   <ABRE_PAR: "(" >
|   <CIERRA_PAR: ")" >
|   <COMMA: "," >
}
/*
 * The nonterminals
 */
 /* 3.1 Estructura general y entrada/salida*/
void programa() : {}
{
    ( sentencia() )*
    <EOF>
}

void sentencia() : {}
{
    asignacion()
|   entrada()
|   salida()
|   condicional()
|   seleccion()
|   bucleWhile()
|   bucleUntil()
|   bucleContador()
|   bloque()
}

void asignacion() : {Token t;}
{
    t= <ID> <ASIG>
    {
        System.out.println("valori " + t.image);
    }
    expresion()
    {
        System.out.println("asigna");
    }
}
void entrada() : {}
{
    <PULL> <ID>
}
void salida() : {int contador = 0;}
{
    <SAY> elementoSalida() {contador++;}
    ( <COMMA> elementoSalida() {contador++;})*
    {
        System.out.println("print " + contador);
    }
}

void elementoSalida() : {Token t;}
{
    t = <CAD> {System.out.println("metecad " + t.image);}
|   expresion()
}
/* 3.2 Bloques y seleccion */
void bloque() : {}
{
    <DO> (sentencia())* <END>
}
void condicional() : {}
{
    <IF> condicion() <THEN> bloque() ( <ELSE> bloque())?
}
void seleccion() : {}
{
    <SELECT> clausulaWHEN() (clausulaWHEN())* (<OTHERWISE> bloque())? <END>
}
void clausulaWHEN() : {}
{
    <WHEN> condicion() <THEN> bloque()
}
/* 3.3 Bucles while, until, contador*/
void bucleWhile() : {}
{
    <DO> <WHILE> condicion() (sentencia())* <END>
}

void bucleUntil() : {}
{
    <DO> <UNTIL> condicion() (sentencia())* <END>
}

void bucleContador() : {}
{
    <DO> <ID> <ASIG> expresion() <TO> expresion() (<BY> (<ADDING>|<SUBTRACTING>)? <NUM>)? (sentencia())* <END>
}

/*3.4 Condiciones y expresiones*/

void condicion() : {}
{
    expresion() (relacional() expresion())?
}

void relacional() : {}
{
    <ASIG>
|   <DIFF>
|   <LESS_THAN>
|   <GREAT_THAN>
|   <LESS_EQ>
|   <GREAT_EQ>
}

void expresion() : {Token op;}
{
    termino() (
        (op = <PLUS> | op = <MINUS>) termino()
        {
            if(op.image.equals("+")){
                System.out.println("add");
            }else{
                System.out.println("sub");
            }
        }
    )*
}

void termino() : {Token op;}
{
    factor() (
        (op = <MULTIPLY> | op = <DIVIDE>) factor()
        {
            if(op.image.equals("*") || op.image.equalsIgnoreCase("MULTIPLY")) {
                System.out.println("mul");
            }else{
                System.out.println("div");
            }
        }
        )*
}

void factor() : {boolean negativo = false;}
{
    (<MINUS> {negativo = true;} | <PLUS>)? atomo()
    {
        if(negativo) {
            System.out.println("mete -1");
            System.out.println("mul");
        }
    }
}

void atomo() : {Token t;}
{
    t = <NUM> { System.out.println("mete " + t.image); }
|   t= <ID> { System.out.println("valord " + t.image);}
|   <ABRE_PAR> expresion() <CIERRA_PAR>
|   elegir()
}

void elegir() : {}
{
    <CHOOSE> <ABRE_PAR> condicion() <COMMA> expresion() <COMMA> expresion() <CIERRA_PAR>
}