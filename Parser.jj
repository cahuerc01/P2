options {
    STATIC = false;
    IGNORE_CASE = true; //Para que no distinga mayusculas y minusculas
}
/*
 * Parser
 */
PARSER_BEGIN(MiniREXX)
public class MiniREXX {
    public static void main (String[] args) throws ParseException {
        //codigo principal
    }
}
PARSER_END(MiniREXX)

/*
 * The terminals
 */

SKIP : /* Ignorar */
{
    " " 
|   "\t"
|   "\n"
|   "\r"
|   ";"
|   "/*" (~["*"])* "*" ("*" | ~["*","\\/"] (~["*"])* "*")* "/" /* Comentarios multilínea */}

TOKEN : /* Palabras reservadas */
{
  < PULL: "pull" >
| < SAY: "say" >
| < IF: "if" >
| < THEN: "then" >
| < ELSE: "else" >
| < DO: "do" >
| < END: "end" >
| < WHILE: "while" >
| < UNTIL: "until" >
| < TO: "to" >
| < BY: "by" >
| < SELECT: "select" >
| < WHEN: "when" >
| < OTHERWISE: "otherwise" >
| < CHOOSE: "choose" >
| < ADDING: "adding" >
| < SUBTRACTING: "subtracting" >
}

TOKEN :
{
    < ID: (["a"-"z","A"-"Z","_"]) (["a"-"z","A"-"Z","0"-"9","_"])* >
|   < NUM: (["0"-"9"]+) >
|   < CAD: "\"" (~["\n","\""])* "\"" | "'" (~["\n","'"])* "'" > /* Cadenas entre comillas dobles o simples */
}
TOKEN :
{
    < ASIG: "=" >
|   < PLUS: "+" >
|   < MINUS: "-" >
|   <MULTIPLY: "*" >
|   <DIVIDE: "/" >
|   <DIFF: "<>" >
|   <LESS_THAN: "<" >
|   <GREAT_THAN: ">" >
|   <LESS_EQ: "<=" >
|   <GREAT_EQ: ">=" >
|   <ABRE_PAR: "(" >
|   <CIERRA_PAR: ")" >
|   <COMMA: "," >
}
/*
 * The nonterminals
 */
 /* 3.1 Estructura general y entrada/salida*/
void programa() : {}
{
    ( sentencia() )*
    <EOF>
}

void sentencia() : {}
{
    asignacion()
|   entrada()
|   salida()
    // resto de opciones
}

void asignacion() : {}
{
    <ID> <ASIG> expresion()
}
void entrada() : {}
{
    <PULL> <ID>
}
void salida() : {}
{
    <SAY> elementoSalida() ( <COMMA> elementoSalida() )*
}

void elementoSalida() : {}
{
    <CAD>
|   expresion()
}
/* 3.2 Bloques y seleccion */
void bloque() : {}
{
    <DO> (sentencia())* <END>
}
void condicional() : {}
{
    <IF> condicion() <THEN> bloque() ( <ELSE> bloque())?
}
void seleccion() : {}
{
    <SELECT> clausulaWHEN() (clausulaWHEN())* (<OTHERWISE> bloque())? <END>
}
void clausulaWHEN() : {}
{
    <WHEN> condicion() <THEN> bloque()
}
/* 3.3 Bucles while, until, contador*/
void bucleWhile() : {}
{
    <DO> <WHILE> condicion() (sentencia())* <END>
}

void bucleUntil() : {}
{
    <DO> <UNTIL> condicion() (sentencia())* <END>
}

void bucleContador() : {}
{
    <DO> <ID> <ASIG> expresion() <TO> expresion() (<BY> (<ADDING>|<SUBTRACTING>)? <NUM>)? (sentencia())* <END>
}

/*3.4 Condiciones y expresiones*/

void condicion() : {}
{
    expresion() (relacional() expresion())?
}

void relacional() : {}
{
    <ASIG>
|   <DIFF>
|   <LESS_THAN>
|   <GREAT_THAN>
|   <LESS_EQ>
|   <GREAT_EQ>
}

void expresion() : {}
{
    termino() ((<PLUS> | <MINUS>) termino())*
}

void termino() : {}
{
    factor() ((<MULTIPLY> | <DIVIDE>) factor())*
}

void factor() : {}
{
    <MINUS> atomo()
|   <PLUS> atomo()
|   atomo()
}

void atomo() : {}
{
    <NUM>
|   <ID>
|   <ABRE_PAR> expresion() <CIERRA_PAR>
|   elegir()
}

void elegir() : {}
{
    <CHOOSE> <ABRE_PAR> condicion() <COMMA> expresion() <COMMA> expresion() <CIERRA_PAR>
}